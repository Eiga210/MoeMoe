{
  "name": "pien-neko",
  "version": "1.1.0",
  "description": "A cute Tamagotchi-style desktop pet built with Electron",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pienneko.app",
    "productName": "Pien Neko",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!renderer/assets/*.docx"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
